<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/prompt_card_bg"
    android:padding="22dp"
    android:layout_margin="16dp">

    <TextView
        android:id="@+id/txtBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PAIGEN CALL GUARDIAN • ACTIVE"
        android:textColor="#00E5FF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.08" />

    <TextView
        android:id="@+id/txtCallerName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Incoming Call"
        android:textColor="#F8FAFC"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtCallerNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="+91 ..."
        android:textColor="#94A3B8"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/txtQuestion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Should I talk?\nक्या मैं आपकी जगह बात करूँ और कॉल रिकॉर्ड करूँ?"
        android:textColor="#E2E8F0"
        android:textSize="15sp"
        android:lineSpacingExtra="4dp" />

    <Button
        android:id="@+id/btnLetPaiGenTalk"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="18dp"
        android:text="Yes, Let PaiGen Talk (Hindi / Auto)"
        android:textColor="#041019"
        android:textStyle="bold"
        android:textSize="14sp"
        android:background="#00E5FF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnAnswerMyself"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="Answer Myself"
            android:textColor="#F8FAFC"
            android:textSize="13sp"
            android:background="#1E293B" />

        <Button
            android:id="@+id/btnDismiss"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Dismiss"
            android:textColor="#FCA5A5"
            android:textSize="13sp"
            android:background="#2D1622" />
    </LinearLayout>
</LinearLayout>
